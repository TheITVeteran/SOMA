# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/conceive-audit-platform
MONGODB_URI_TEST=mongodb://localhost:27017/conceive-audit-platform-test

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,xlsx,xls,csv,docx,png,jpg,jpeg

# AI Integration (OpenAI API - Optional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# SOMA Integration (The "Powered By" Brain)
# Point this to your company's SOMA server instance.
# If SOMA is on the same machine as this backend, use localhost:3001.
# If SOMA is on a dedicated AI server, use that IP (e.g. http://192.168.1.50:3001)
SOMA_API_URL=http://localhost:3001

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis (for session management and caching)
REDIS_URL=redis://localhost:6379

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Audit Trail
AUDIT_RETENTION_DAYS=2555  # 7 years for compliance
